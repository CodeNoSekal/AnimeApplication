<?xml version="1.0" encoding="utf-8"?><!--
   Правила для облачного бэкапа и прямого переноса данных на новое устройство
   (API 31+). Токены авторизации хранятся зашифрованными (см.
   TokenCipher/TokenStorageImpl), поэтому datastore/auth_prefs.preferences_pb
   больше не исключается ни из cloud-backup, ни из device-transfer — ключ
   шифрования переносится вместе с файлом, и сессия сохраняется после
   восстановления/переноса на новое устройство.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
